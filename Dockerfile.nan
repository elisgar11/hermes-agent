FROM nousresearch/hermes-agent@sha256:adb7890916de63245523492be8f68f9d2095fecbec4e2a6dab7960381f0fc002

ENV HERMES_HOME=/data HERMES_WRITE_SAFE_ROOT=/data
COPY nan-config.yaml /opt/hermes/cli-config.yaml.example
COPY --chmod=0755 nan-stage2.sh /opt/hermes/docker/nan-stage2.sh
RUN mv /opt/hermes/docker/stage2-hook.sh /opt/hermes/docker/stage2-upstream.sh && \
    ln -s /opt/hermes/docker/nan-stage2.sh /opt/hermes/docker/stage2-hook.sh && \
    python3 -c 'from pathlib import Path; p = Path("/opt/hermes/tools/transcription_chunking.py"); s = p.read_text(); old = "_OPENAI_MODEL_MAX_SECONDS = {"; assert s.count(old) == 1; p.write_text(s.replace(old, old + "\"whisper\": 120.0, ", 1))'
CMD ["gateway"]
